# OpenOctopus 配置示例。复制为 .env 后填入真实值；.env 已被 gitignore，切勿提交真实密钥。

# --- 基础 ---
# SQLite 数据库文件路径
DB_PATH=data/openoctopus.db
# 真实下单模式开关（1=开启真实调用，0=演练模式）
LIVE_MODE=0
# 人民币兑卢布汇率
PRICE_CNY_TO_RUB=12

# --- Ozon Seller API ---
OZON_CLIENT_ID=
OZON_API_KEY=

# --- OpenRouter（文案 / 图片理解模型）---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
CONTENT_MODEL=qwen/qwen3-30b-a3b:free
IMAGE_MODEL=qwen/qwen2.5-vl-72b-instruct:free

# --- Cloudflare R2（图片存储）---
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

# --- 其他 ---
# 水印字体路径（macOS 自带中文字体）
FONT_PATH=/System/Library/Fonts/Supplemental/Arial Unicode.ttf
# Playwright 登录态文件路径（1688 会话）
PLAYWRIGHT_STORAGE_STATE=data/playwright_state.json
